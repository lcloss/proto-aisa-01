  "font": {
    "display": "'Fraunces', Georgia, 'Times New Roman', serif",
    "body": "'Atkinson Hyperlegible', system-ui, sans-serif"
  },
  "text": {
    "caption": "1rem",
    "body": "1.125rem",
    "body-lg": "1.25rem",
    "h4": "1.375rem",
    "h3": "1.75rem",
    "h2": "2.25rem",
    "h1": "3rem",
    "display": "3.75rem"
  },
  "leading": {
    "tight": "1.15",
    "snug": "1.35",
    "normal": "1.6"
  },
  "weight": {
    "regular": "400",
    "medium": "500",
    "body-bold": "700"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem",
    "9": "6rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px oklch(0.285 0.004 84.6 / 0.06)",
    "md": "0 2px 8px oklch(0.285 0.004 84.6 / 0.08), 0 1px 2px oklch(0.285 0.004 84.6 / 0.04)",
    "lg": "0 8px 24px oklch(0.285 0.004 84.6 / 0.10), 0 2px 6px oklch(0.285 0.004 84.6 / 0.05)"
