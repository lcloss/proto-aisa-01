    "destructive": "oklch(0.521 0.158 29.2)",
    "destructive-foreground": "oklch(1 0 0)",

    "info-soft": "oklch(0.959 0.013 241.0)",
    "info-soft-foreground": "oklch(0.44 0.12 248.2)",
